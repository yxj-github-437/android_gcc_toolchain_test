From 824d9ac0b55b8ce53df889527c001a340ef93b4f Mon Sep 17 00:00:00 2001
From: yxj-github-437 <2457369732@qq.com>
Date: Mon, 19 Jan 2026 04:05:30 +0800
Subject: [PATCH] enable canadian cross compile for host android

---
 configure                             |  5 +++-
 gcc/rust/Make-lang.in                 |  4 +--
 gcc/rust/cargo.sh                     | 40 +++++++++++++++++++++++++++
 libgrust/libformat_parser/Makefile.in |  4 +--
 4 files changed, 48 insertions(+), 5 deletions(-)
 create mode 100755 gcc/rust/cargo.sh

diff --git a/configure b/configure
index e2150f50aac..b0b939e7c34 100755
--- a/configure
+++ b/configure
@@ -10437,7 +10437,10 @@ $as_echo "$as_me: WARNING: --enable-host-shared required to build $language" >&2
           # "'cargo' should build for the host system" is resolved:
           { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: use of cargo not yet supported here in Canadian cross configurations" >&5
 $as_echo "$as_me: WARNING: use of cargo not yet supported here in Canadian cross configurations" >&2;}
-          have_cargo=no
+          case $host in
+            *android*);;
+            *) have_cargo=no;;
+          esac
         else
           # Assume that cargo-produced object files are compatible with what
           # we're going to build here.
diff --git a/gcc/rust/Make-lang.in b/gcc/rust/Make-lang.in
index 620bf07ee52..a31450241ec 100644
--- a/gcc/rust/Make-lang.in
+++ b/gcc/rust/Make-lang.in
@@ -550,5 +550,5 @@ rust/%.o: rust/metadata/%.cc
 rust/libffi_polonius.a: \
 	rust/checks/errors/borrowck/ffi-polonius/Cargo.toml \
 	$(wildcard $(srcdir)/rust/checks/errors/borrowck/ffi-polonius/src/*)
-	cd $(srcdir)/rust/checks/errors/borrowck/ffi-polonius/ && cargo build --offline --release --target-dir $(objdir)/rust/ffi-polonius
-	cp rust/ffi-polonius/release/libffi_polonius.a rust/libffi_polonius.a
+	$(srcdir)/rust/cargo.sh build --source-dir=$(srcdir)/rust/checks/errors/borrowck/ffi-polonius --offline --release --target-dir $(objdir)/rust/ffi-polonius --target=$(host)
+	ln -srf $$(find $(objdir)/rust/ffi-polonius -name libffi_polonius.a -type f -not -type l) $(objdir)/rust/libffi_polonius.a
diff --git a/gcc/rust/cargo.sh b/gcc/rust/cargo.sh
new file mode 100755
index 00000000000..ceeb2fdcc1e
--- /dev/null
+++ b/gcc/rust/cargo.sh
@@ -0,0 +1,40 @@
+#!/bin/bash
+
+CARGO_COMMANDS=""
+
+while [[ $# > 0 ]]; do
+    case $1 in
+        --target=*)
+            TARGET=${1/--target=/}
+            case $TARGET in
+                x86_64-*-linux-gnu)
+                    RUST_TARGET="x86_64-unknown-linux-gnu"
+                    ;;
+                aarch64-*-linux-android)
+                    RUST_TARGET="aarch64-linux-android"
+                    ;;
+                arm-*-linux-androideabi)
+                    RUST_TARGET="arm-linux-androideabi"
+                    ;;
+                x86_64-*-linux-android)
+                    RUST_TARGET="x86_64-linux-android"
+                    ;;
+                i686-*-linux-android)
+                    RUST_TARGET="i686-linux-android"
+                    ;;
+                *)
+                    RUST_TARGET=$TARGET;;
+            esac
+            CARGO_COMMANDS="$CARGO_COMMANDS --target=$RUST_TARGET"
+        ;;
+        --source-dir=*)
+            cd ${1/--source-dir=/}
+            ;;
+        *)
+        CARGO_COMMANDS="$CARGO_COMMANDS $1";;
+    esac
+    shift
+done
+
+cargo $CARGO_COMMANDS
+
diff --git a/libgrust/libformat_parser/Makefile.in b/libgrust/libformat_parser/Makefile.in
index b64ca2a4147..158b1cab0a9 100644
--- a/libgrust/libformat_parser/Makefile.in
+++ b/libgrust/libformat_parser/Makefile.in
@@ -432,8 +432,8 @@ all-local: $(LIBFORMAT_PARSER)
 
 # TODO: Improve `cargo` invocation with host specific flags, possibly creating a $(CARGO) variable?
 $(LIBFORMAT_PARSER): $(srcdir)/Cargo.toml $(srcdir)/src/*.rs
-	cd $(srcdir) && \
-	cargo build --offline --target-dir $(RUST_BUILD_DIR)
+	$(srcdir)/../../gcc/rust/cargo.sh build --source-dir=$(srcdir) --offline --target-dir $(RUST_BUILD_DIR) --target=$(host)
+	ln -srf $$(find $(RUST_BUILD_DIR) -name $$(basename $(LIBFORMAT_PARSER)) -type f -not -type l) $(RUST_BUILD_DIR)/$(LIBFORMAT_PARSER)
 
 # Tell versions [3.59,3.63) of GNU make to not export all variables.
 # Otherwise a system limit (for SysV at least) may be exceeded.
-- 
2.53.0

